{
  "name": "screeps-harabibot-v2",
  "version": "0.1.0",
  "private": true,
  "description": "A TypeScript rewrite of HarabiBot for Screeps.",
  "scripts": {
    "build": "rollup --config",
    "check": "npm run typecheck && npm test && npm run build && npm run format",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.test.json"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "26.4.1",
    "@types/screeps": "3.4.0",
    "prettier": "3.9.6",
    "rollup": "4.63.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
